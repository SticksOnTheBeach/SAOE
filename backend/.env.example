# exemple de fichier de config pour la base de donnée

DB_URL=jdbc:postgresql://localhost:5432/saoe
DB_USER=...
DB_PASSWORD=...


# commande docker pour créer une base de donnée dans docker :

docker run --name saoe-db -e POSTGRES_USER=saoe -e POSTGRES_PASSWORD=motdepasse -e POSTGRES_DB=saoe -p 5432:5432 -d postgres:16